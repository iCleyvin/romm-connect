# Expo SDK 55 is pinned to a *canary prerelease* (e.g. 55.0.x-canary-YYYYMMDD).
# Semver ranges without a prerelease tag — such as the peer dependency
# `expo-font@">=14.0.4"` declared by @expo/vector-icons@15.x — do NOT match
# prerelease versions per the semver spec. Since the whole canary SDK ships
# prerelease versions (and `expo` pulls @expo/vector-icons transitively, so it
# can't be removed), strict peer resolution is not achievable here.
#
# Enabling legacy-peer-deps makes installs reproducible: both `npm ci` (CI) and
# `npm install` (local) resolve identically instead of erroring on ERESOLVE.
# Revisit / remove this once the project moves to a stable (non-canary) Expo SDK.
legacy-peer-deps=true
